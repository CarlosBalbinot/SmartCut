# ─────────────────────────────────────────────────────────────────────────────
# SmartCut — variáveis de ambiente da raiz (exemplo / template versionado)
# ─────────────────────────────────────────────────────────────────────────────
# A fonte ÚNICA de configuração do backend é backend/.env (ver
# backend/.env.example). Este .env da raiz servia ao docker-compose, que foi
# removido; nenhum processo do SmartCut o lê hoje.
#
# Gere segredos fortes com:
#     python -c "import secrets; print(secrets.token_hex(32))"

# ── Segredo JWT do backend (CRITICO) ─────────────────────────────────────────
SECRET_KEY=troque-esta-secret-key-com-openssl-rand-hex-32

# ── Backend (o template completo, com onde cada variável é usada, está em
# ── backend/.env.example) ─────────────────────────────────────────────────────
BACKUP_DIR=
BACKUP_MANTER=30
BACKUP_INTERVAL_SEC=21600
CERTIFICADO_DIR=
CERT_SENHA_KEY=

# ── Opcionais de producao ────────────────────────────────────────────────────
# COOKIE_SECURE=true            # papel/cookie HttpOnly Secure atras de HTTPS
