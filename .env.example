# ─────────────────────────────────────────────────────────────────────────────
# SmartCut — variáveis de ambiente (exemplo / template versionado)
# ─────────────────────────────────────────────────────────────────────────────
# Copie para `.env` (NAO versione a copia) e ajuste os valores:
#     cp .env.example .env
#
# Nada aqui é segredo real: use placeholders em ambiente de desenvolvimento e
# gere valor REAL em produção (nunca commite o .env).
#
# Gere segredos fortes com:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   (ou, se tiver OpenSSL:  openssl rand -hex 32)
#
# Rotação de segredos (SECRET_KEY / POSTGRES_PASSWORD):
#   1. Gere novo valor; 2. troque no .env; 3. reinicie os serviços
#      (os JWTs antigos deixam de validar — usuários refazem login); 
#   4. no Postgres, `ALTER USER smartcut PASSWORD 'novo'` e ajuste DATABASE_URL.

# ── Banco Postgres (usado pelo docker-compose) ───────────────────────────────
POSTGRES_USER=smartcut
POSTGRES_PASSWORD=troque-este-postgres-password
POSTGRES_DB=smartcut_db

# ── Segredo JWT do backend (CRITICO) ─────────────────────────────────────────
# Mesmo valor usado no painel do vendedor e no sistema administrativo.
SECRET_KEY=troque-esta-secret-key-com-openssl-rand-hex-32

# ── Backend ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
NESTING_TIMEOUT_SEC=120

# ── Backup automatico (SQLite, item 3.3) ─────────────────────────────────────
# BACKUP_DIR vazio = pasta "backups" ao lado do arquivo .db.
BACKUP_DIR=
BACKUP_RETENTION_DIAS=7
BACKUP_INTERVAL_SEC=21600

# ── Certificado digital NF-e (itens 4.1/4.2) ─────────────────────────────────
# Pasta padrao onde guardar os certificados .pfx — FORA da arvore de codigo.
# Desktop: o Electron injeta <userData>/Certificados automaticamente.
CERTIFICADO_DIR=
# Chave mestre para cifrar em repouso a senha do certificado (item 4.2).
# Docker/servidor: defina para poder salvar a senha (segredo NUNCA vai em
# texto claro pro banco). Desktop: NAO defina — o app gera/protege a propria
# chave com o cofre do sistema (safeStorage/DPAPI) via SMARTCUT_CERT_KEY.
# Gere com:  python -c "import secrets; print(secrets.token_hex(32))"
CERT_SENHA_KEY=

# ── Portas publicadas no host (compose) ──────────────────────────────────────
FRONTEND_PORT=8080
BACKEND_PORT=8000

# ── Opcionais de producao ────────────────────────────────────────────────────
# COOKIE_SECURE=true            # papel/cookie HttpOnly Secure atras de HTTPS
# SMARTCUT_DB_PATH=/caminho/do/smartcut.db   # desktop: aponta pro banco SQLite