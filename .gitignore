# Dependências
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Banco de dados local (o SQLite em modo WAL cria -wal/-shm ao lado do .db)
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
# Backup do banco feito antes de uma migração (ex.: *.db.bak-motor-v1)
*.db.bak*

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Build e dist (frontend/dist, backend/build, backend/dist, release/...)
dist/
build/
.vite/
out/
release/
*.exe
*.dmg

# Claude Code — contexto privado (config local; .claudeignore é
# política compartilhada do projeto e continua versionado)
.claude/

# Saída do build-backend (PyInstaller): só o .gitkeep é versionado. Pastas
# criadas ao rodar o exe direto de electron/bin (relatorios/, uploads/) são
# sobras locais — os modelos vão no pacote a partir de relatorios/.
electron/bin/relatorios/
electron/bin/uploads/

# Uploads e arquivos gerados localmente (em dev ficam em backend/uploads)
uploads/

# Certificados digitais — CRÍTICO
Certificados/
*.pfx
*.p12
*.cer

# Build de release assinado (item 6.1): guarda CSC_LINK/CSC_KEY_PASSWORD
release.env

# Logs
*.log
backend/logs/

# Backups automáticos do SQLite (backups/ ao lado do .db)
backups/

# IDE
.vscode/
.idea/

# Alembic — migrações VERSIONADAS: backend/alembic/versions/*.py são
# commitadas. A pasta legado/ guarda migrações antigas nunca commitadas
# (substituídas pela baseline) e não entra no repo.
backend/alembic/legado/

# Anotação pessoal do desenvolvedor (caminhos da máquina): fora do git.
docs/INFOS.md

# OS
.DS_Store
Thumbs.db

# Fichas de corte geradas em teste (PDFs locais, não versionar)
fichas-teste/
