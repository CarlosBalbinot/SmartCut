# DB / Docker volumes
postgres_data/

# Alembic — migrações VERSIONADAS (item 5.2): backend/alembic/versions/*.py
# são commitadas no git (baseline + evoluções futuras). A pasta legado/
# guarda migrações antigas nunca commitadas (substituídas pela baseline) e
# não deve entrar no repo nem na imagem Docker.
backend/alembic/legado/

# Documentação (parte 10.2): docs/ é versionado no git (ROADMAP, ESTRUTURA,
# FUNCIONALIDADES, FINANCEIRO, ELECTRON etc.) — nova máquina tem a documentação.
# Exceção: INFOS.md é anotação pessoal do desenvolvedor (caminhos absolutos da
# máquina) e permanece fora do versionamento.
docs/INFOS.md

# Parte 10.1: artefatos de build do engine de nesting (node-gyp) NÃO são
# versionados — binários (Release/ com addon.node, .o, .d) e scaffolding gerado
# (Makefile, binding.Makefile, *.target.mk, config.gypi, gyp-mac-tool). O runtime
# usa JS puro (nesting/nest_worker.js + nesting/svgnest), empacotado no
# smartcut.spec via datas. Ver backend/services/nesting/README.md.
backend/services/nesting/engine/

# Lib de nesting de terceiros (empacotada apenas, não versionada)
backend/nesting/svgnest/

# OS
.DS_Store
Thumbs.db

# Cobertura de testes (pytest+coverage, Parte 8)
backend/.coverage
backend/htmlcov/
.htmlcov/

