# Dependências
node_modules/
**/node_modules/

# Python
__pycache__/
**/__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Banco de dados local
*.db
*.sqlite
*.sqlite3
# Backup do banco feito antes de uma migração (ex.: *.db.bak-motor-v1)
*.db.bak*

# Variáveis de ambiente
.env
.env.local
.env.*.local

# Build e dist
dist/
build/
.vite/
frontend/dist/
electron/dist/
out/
release/
*.exe
*.dmg

# Claude Code — contexto privado (config local; .claudeignore é
# política compartilhada do projeto e continua versionado)
.claude/

# Saída do build-backend (PyInstaller): só o .gitkeep é versionado. Pastas
# criadas ao rodar o exe direto de electron/bin (relatorios/, uploads/) são
# sobras locais — os modelos vão no pacote a partir de relatorios/.
electron/bin/relatorios/
electron/bin/uploads/

# Uploads e arquivos gerados localmente
backend/uploads/
uploads/

# Certificados digitais — CRÍTICO
Certificados/
backend/Certificados/
*.pfx
*.p12
*.cer

# Build de release assinado (item 6.1): guarda CSC_LINK/CSC_KEY_PASSWORD
release.env

# Logs
*.log
backend/logs/

# Backups automáticos do SQLite (item 3.3)
backups/
backend/backups/

# IDE
.vscode/
.idea/

# DB / Docker volumes
postgres_data/

# Alembic — migrações VERSIONADAS (item 5.2): backend/alembic/versions/*.py
# são commitadas no git (baseline + evoluções futuras). A pasta legado/
# guarda migrações antigas nunca commitadas (substituídas pela baseline) e
# não deve entrar no repo nem na imagem Docker.
backend/alembic/legado/

# Documentação (parte 10.2): docs/ é versionado no git (ROADMAP, ESTRUTURA,
# FUNCIONALIDADES, FINANCEIRO, ELECTRON etc.) — nova máquina tem a documentação.
# Exceção: INFOS.md é anotação pessoal do desenvolvedor (caminhos absolutos da
# máquina) e permanece fora do versionamento.
docs/INFOS.md

# OS
.DS_Store
Thumbs.db

# Cobertura de testes (pytest+coverage, Parte 8)
backend/.coverage
backend/htmlcov/
.htmlcov/

# Fichas de corte geradas em teste (PDFs locais, não versionar)
fichas-teste/
