# ─────────────────────────────────────────────────────────────────────────────
# SmartCut backend — variáveis de ambiente para execucao LOCAL (sem Docker)
# ─────────────────────────────────────────────────────────────────────────────
# Copie para `.env` (dentro de backend/, NAO versione) e ajuste. O backend
# usa este arquivo quando roda com `uvicorn main:app` a partir de backend/.
#
# Nada aqui é segredo real — troque SECRET_KEY por um valor gerado:
#     python -c "import secrets; print(secrets.token_hex(32))"

# Banco local (padrao: SQLite ao lado do projeto). O Electron empacotado
# sobrescreve via SMARTCUT_DB_PATH (aponta pro userData do usuario).
DATABASE_URL=sqlite:///./smartcut.db

# Segredo JWT (mesmo valor para painel do vendedor e administrativo).
SECRET_KEY=troque-esta-secret-key-com-openssl-rand-hex-32

# ── Uploads ───────────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50
NESTING_TIMEOUT_SEC=120

# ── Backup automatico SQLite (item 3.3) ──────────────────────────────────────
# BACKUP_DIR vazio = pasta "backups" ao lado do smartcut.db
BACKUP_DIR=
BACKUP_RETENTION_DIAS=7
BACKUP_INTERVAL_SEC=21600

# ── Certificado digital NF-e (itens 4.1/4.2) ─────────────────────────────────
CERTIFICADO_DIR=
# Chave mestre p/ cifrar a senha do certificado. Desktop: NAO definir (o app
# injeta SMARTCUT_CERT_KEY via cofre do sistema). Fora do desktop (dev/Docker)
# defina para poder salvar a senha: python -c "import secrets; print(secrets.token_hex(32))"
CERT_SENHA_KEY=

# ── Cookie de sessao (em producao atras de HTTPS) ────────────────────────────
# COOKIE_SECURE=true
# COOKIE_SAMESITE=lax