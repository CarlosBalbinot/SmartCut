{
  "name": "smartcut",
  "version": "1.3.0",
  "description": "Sistema de gestão têxtil",
  "author": "Vaidosa Fitness",
  "main": "electron/main.js",
  "scripts": {
    "electron-dev": "concurrently \"npm run dev --prefix frontend\" \"wait-on http://localhost:5173 && cross-env NODE_ENV=development electron .\"",
    "build-frontend": "npm run build --prefix frontend",
    "build-backend": "cd backend && py -3.12 -m PyInstaller smartcut.spec --clean --distpath ../electron/bin",
    "predist": "npm run build-frontend && npm run build-backend",
    "dist": "npm run registrar-relatorios && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist-quick": "npm run build-frontend && npm run registrar-relatorios && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",
    "dist:assinado": "node electron/release-build.js",
    "registrar-relatorios": "node electron/relatorios-sync.js registrar",
    "test:electron": "node --test \"electron/tests/*.test.js\""
  },
  "build": {
    "appId": "com.vaidosafitness.smartcut",
    "productName": "SmartCut",
    "copyright": "Copyright © 2026 Vaidosa Fitness",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "!electron/bin/**/*",
      "!electron/release-build.js",
      "!electron/tests/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/bin",
        "to": "bin",
        "filter": ["smartcut-backend.exe"]
      },
      {
        "from": "relatorios",
        "to": "relatorios-padrao",
        "filter": ["**/*", "!**/*.novo.*"]
      },
      {
        "from": "assets",
        "to": "assets"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/favicon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerLanguages": ["pt_BR"],
      "language": "1046",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SmartCut"
    }
  },
  "devDependencies": {
    "electron": "^29.0.0",
    "electron-builder": "^24.0.0",
    "concurrently": "^8.0.0",
    "wait-on": "^7.0.0",
    "cross-env": "^7.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  }
}
